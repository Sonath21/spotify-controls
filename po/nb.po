#: extension.js:72
msgid "Spotify Controls"
msgstr "Spotify-kontroller"

#: extension.js:128
msgid "Previous track"
msgstr "Forrige spor"

#: extension.js:133 extension.js:685
msgid "Pause"
msgstr "Pause"

#: extension.js:138
msgid "Next track"
msgstr "Neste spor"

#: extension.js:191
msgid "No Track Playing"
msgstr "Ingen spor spilles"

#: extension.js:634
msgid "Unknown Artist"
msgstr "Ukjent artist"

#: extension.js:654
msgid "Unknown Title"
msgstr "Ukjent tittel"

#: extension.js:686
msgid "Play"
msgstr "Spill av"

#: prefs.js:78
msgid "Spotify Controls Preferences"
msgstr "Innstillinger for Spotify-kontroller"

#: prefs.js:82
msgid "Settings"
msgstr "Innstillinger"

#: prefs.js:90
msgid "General Settings"
msgstr "Generelle innstillinger"

#: prefs.js:97
msgid "Far Left"
msgstr "Helt til venstre"

#: prefs.js:98
msgid "Mid Left"
msgstr "Midt i venstre del"

#: prefs.js:99
msgid "Rightmost Left"
msgstr "Lengst til høyre i venstre del"

#: prefs.js:100
msgid "Middle Left"
msgstr "Midten, venstre side"

#: prefs.js:101
msgid "Center"
msgstr "Midten"

#: prefs.js:102
msgid "Middle Right"
msgstr "Midten, høyre side"

#: prefs.js:103
msgid "Leftmost Right"
msgstr "Lengst til venstre i høyre del"

#: prefs.js:104
msgid "Mid Right"
msgstr "Midt i høyre del"

#: prefs.js:105
msgid "Far Right"
msgstr "Helt til høyre"

#: prefs.js:112
msgid "Indicator Position"
msgstr "Plassering av indikator"

#: prefs.js:113
msgid "Select the position of the Spotify controls in the top bar"
msgstr "Velg hvor Spotify-kontrollene skal plasseres i toppanelet"

#: prefs.js:136
msgid "Left"
msgstr "Venstre"

#: prefs.js:137
msgid "Right"
msgstr "Høyre"

#: prefs.js:144
msgid "Playback Controls Position"
msgstr "Plassering av avspillingskontroller"

#: prefs.js:145
msgid "Select whether the playback controls should appear on the left or right"
msgstr "Velg om avspillingskontrollene skal vises til venstre eller høyre"

#: prefs.js:168
msgid "Enable Volume Control"
msgstr "Slå på volumkontroll"

#: prefs.js:169
msgid ""
"Toggle the volume control feature using the scroll wheel over the song title"
msgstr "Juster volumet med rullehjulet over sangtittelen"

#: prefs.js:187
msgid "Enable Middle Click Play/Pause"
msgstr "Spill av/pause med midtklikk"

#: prefs.js:188
msgid "Allows toggling the current track with a middle-click on the extension."
msgstr "Veksle mellom avspilling og pause med midtklikk på utvidelsen."

#: prefs.js:206
msgid "Minimize on Second Click"
msgstr "Minimer ved nytt klikk"

#: prefs.js:207
msgid ""
"If true, clicking the extension again minimizes Spotify if it is already in "
"the foreground."
msgstr ""
"Når slått på, minimeres Spotify ved et nytt klikk på utvidelsen hvis vinduet "
"allerede er i forgrunnen."

#: prefs.js:229
msgid "Display Options"
msgstr "Visningsvalg"

#: prefs.js:236
msgid "Show Playback Controls"
msgstr "Vis avspillingskontroller"

#: prefs.js:237
msgid ""
"Toggle the visibility of the playback controls (Previous, Play/Pause, Next)"
msgstr ""
"Vis eller skjul avspillingskontrollene (forrige, spill av/pause, neste)"

#: prefs.js:255
msgid "Show Spotify Icon"
msgstr "Vis Spotify-ikon"

#: prefs.js:256
msgid "Toggle the visibility of the Spotify logo in the top bar"
msgstr "Vis eller skjul Spotify-logoen i toppanelet"

#: prefs.js:274
msgid "Show Artist/Track Info"
msgstr "Vis artist og spor"

#: prefs.js:275
msgid ""
"Toggle the visibility of the Artist and Track information in the top bar"
msgstr "Vis eller skjul informasjon om artist og spor i toppanelet"

#: prefs.js:293
msgid "Maximum Width (pixels)"
msgstr "Maksimal bredde (piksler)"

#: prefs.js:294
msgid "Limit how wide the extension label can be in the top bar (0 = no limit)"
msgstr ""
"Begrens hvor bred utvidelsens tekst kan være i toppanelet (0 = ingen grense)"

#: prefs.js:336
msgid "About"
msgstr "Om"

#: prefs.js:348
msgid "Version"
msgstr "Versjon"

#: prefs.js:356
msgid "Website"
msgstr "Nettsted"

