#, javascript-format
msgid "%d person"
msgid_plural "%d people"
msgstr[0] "%d person"
msgstr[1] "%d personer"

#: prefs.js:399
msgid "License"
msgstr "Lisens"

#: prefs.js:456
msgid "Open in browser"
msgstr "Åpne i nettleser"

